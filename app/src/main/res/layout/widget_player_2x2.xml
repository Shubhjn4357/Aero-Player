<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container_2x2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_art_2x2"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/widget_art_background"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_widget_music"
        android:padding="10dp"
        android:contentDescription="Album Art" />

    <TextView
        android:id="@+id/widget_title_2x2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aero Player"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:ellipsize="end"
        android:maxLines="1"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/widget_artist_2x2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select track to play"
        android:textColor="#A0A5B5"
        android:textSize="12sp"
        android:gravity="center"
        android:ellipsize="end"
        android:maxLines="1"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="10dp">

        <ImageButton
            android:id="@+id/widget_btn_prev_2x2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_prev"
            android:contentDescription="Previous" />

        <ImageButton
            android:id="@+id/widget_btn_play_pause_2x2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_play"
            android:contentDescription="Play or Pause"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" />

        <ImageButton
            android:id="@+id/widget_btn_next_2x2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_next"
            android:contentDescription="Next" />
    </LinearLayout>

</LinearLayout>
