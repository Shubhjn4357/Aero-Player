<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="360dp"
    android:height="200dp"
    android:viewportWidth="360"
    android:viewportHeight="200">
    <!-- Background Gradient -->
    <path
        android:pathData="M0,0 h360 v200 h-360 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="360"
                android:endY="200"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF2E0854"/> <!-- Deep Purple -->
                <item android:offset="0.5" android:color="#FF120024"/> <!-- Very Dark Violet -->
                <item android:offset="1.0" android:color="#FF001220"/> <!-- Deep Blue-Black -->
            </gradient>
        </aapt:attr>
    </path>
    <!-- Wave 1 -->
    <path
        android:pathData="M0,100 Q90,50 180,100 T360,100 L360,200 L0,200 Z"
        android:strokeWidth="2">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="50"
                android:endX="360"
                android:endY="200"
                android:type="linear">
                <item android:offset="0.0" android:color="#33A147E5"/> <!-- Semi-transparent Violet -->
                <item android:offset="1.0" android:color="#00000000"/>
            </gradient>
        </aapt:attr>
    </path>
    <!-- Wave 2 -->
    <path
        android:pathData="M0,120 Q90,170 180,120 T360,120 L360,200 L0,200 Z"
        android:strokeWidth="2">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="100"
                android:endX="360"
                android:endY="200"
                android:type="linear">
                <item android:offset="0.0" android:color="#2200F0FF"/> <!-- Semi-transparent Cyan -->
                <item android:offset="1.0" android:color="#00000000"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
